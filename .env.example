# ==============================================================================
# Enterprise Playwright Automation Framework - Environment Configuration
# ==============================================================================

# Application Base URL
BASE_URL=https://ehr.drcatalyst.com/#/login

# Authentication Credentials
CLINIC=your-clinic-code
APP_USERNAME=your-app-username
PASSWORD=your-app-password

# Storage State for Session Reuse
STORAGE_STATE_PATH=./auth/user-state.json

# Browser Configuration (chromium | firefox | webkit | chrome | msedge)
BROWSER=chromium
HEADLESS=true
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Timeouts in milliseconds
DEFAULT_TIMEOUT=45000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=45000

# Execution Orchestration
WORKERS=2

# Retry Policy: 5 retries (1 initial + 5 retries = 6 attempts total)
RETRIES=5

# AI-Powered Self-Healing Mode: off | suggest | approved
# 'suggest' is default (generates diffs & proposals without mutating code)
HEALING_MODE=suggest

# AI Provider Configuration (Optional - for advanced LLM reasoning)
AI_PROVIDER=none
AI_API_KEY=

# Logging & Security
LOG_LEVEL=INFO
REDACT_SECRETS=true
